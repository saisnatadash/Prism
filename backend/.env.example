# Local dev default matches docker-compose.yml. For production, set this to
# your Supabase connection string instead (Project Settings > Database).
DATABASE_URL=postgresql+psycopg2://prism:prism@localhost:5432/prism

# Groq API key for Qwen3-32B (https://console.groq.com/keys)
GROQ_API_KEY=

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000
