# SQLite by default (zero setup). Point at Postgres+PostGIS in production:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/prism
DATABASE_URL=sqlite:///./prism.db

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Seeds synthetic demo data on startup if the DB is empty. Set to "false"
# once you wire in a real ingest job and don't want demo rows re-added.
AUTO_SEED=true

# Optional: enables LLM-drafted hypotheses in app/core/engine.py::draft_hypothesis.
# Leaving this unset keeps the engine fully rule-based (recommended until ready).
# OPENAI_API_KEY=
# QWEN_API_URL=
